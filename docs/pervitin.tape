# The demo in the README: what is typed and for how long.
# Render it with docs/render-demo.sh, which also compresses the result.
Output pervitin-raw.gif
Set Shell zsh
Set FontSize 13
Set Width 1240
Set Height 570
Set Padding 16
Set Framerate 12
Env PERVITIN_DRY_RUN "1"
Env PERVITIN_QUIET "1"
Env PERVITIN_STAGE "wired"
Hide
Type "clear && pervitin" Enter
Show
Sleep 9s
Up
Sleep 1.8s
Up
Sleep 2.2s
Up
Sleep 1.3s
Up
Sleep 1.3s
Up
Sleep 1.6s
Up
Sleep 1.2s
Up
Sleep 3s
Right
Space
Sleep 5s
Left
Space
Sleep 7s
